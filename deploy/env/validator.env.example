# /etc/fugal/validator.env — mode 0600. Read by deploy/systemd/fugal-validator.service.
#
# Everything here is consensus-relevant or operational; nothing is secret. A
# validator holds no API key (it never calls a model) and no coldkey.

# EDIT THESE. The example is pointed at the TEST network on purpose: a
# validator that keeps them runs happily against testnet with no error.
# Mainnet: FUGAL_NETWORK=finney and FUGAL_NETUID=70.
FUGAL_NETWORK=test
FUGAL_NETUID=552
WALLET_NAME=fugal_validator
HOTKEY_NAME=default

# MUST equal the subnet's tempo x 12 s. tempo 360 -> 4320. When they differ,
# some epochs' weights are overwritten before Yuma reads them (MAINNET_LAUNCH §2).
# `scripts/provision_subnet.py --status` prints ALIGNED or MISALIGNED.
FUGAL_EPOCH_INTERVAL=4320

# Testnet warm-up ONLY (netuid 552): every neuron on it, miners included, runs
# FUGAL_EXPLORE_FRACTION=0.5 so the reference frame fills in about 2 days; the
# miners' value is in deploy/dstack/docker-compose.test.yaml. A consensus
# constant: a neuron refuses it on finney (by genesis hash) and starts with a
# warning elsewhere. Leave it unset on mainnet.
# FUGAL_EXPLORE_FRACTION=0.5

# Protocol v2 activates at ONE epoch boundary block, identical on every
# validator (a consensus input: in the digest; refused at startup if it is
# not a boundary; unset means v1 forever, and a validator that leaves it
# unset after the flip scores by v1 rules with a different digest from the
# first epoch — VALIDATOR_GUIDE "Protocol v2: flip procedure"). The v2 miner
# image reads the same value from its compose, so the flip also means a new
# compose hash and a new approved entry (APPROVED_ENTRY_ROTATION).
# FUGAL_V2_ACTIVATION_BLOCK=

# Comma-separated approved entries, each `<base_measurement>:<compose_hash>`.
# The base is `measurement_id()` of the dstack image on the cloud platform; the
# compose hash is sha256 of the miner's app-compose.json RAW BYTES
# (`scripts/compute_app_identity.py --compose ... --base ...`). A bare base
# would accept ANY application on that image, so --live refuses to start with
# one (diligence 2026-10, finding 1).
FUGAL_TEE_MEASUREMENTS=

# Do NOT set FUGAL_BENCHMARK_POOL. The validator loads the manifest-pinned pool
# through load_all() and refuses to start if it does not match. A materialised
# pool file is only acceptable if it verifies against the same manifest.

# Archive-capable subtensor endpoint(s), comma-separated. The validator pins
# reads to the boundary and collection blocks; a non-archive node keeps ~300
# blocks and refuses older ones after a late start or a retried epoch.
# FUGAL_ARCHIVE_ENDPOINTS=wss://archive.chain.opentensor.ai:443
# FUGAL_FALLBACK_ENDPOINTS=

# Where DCAP collateral is fetched from (Intel-signed; the endpoint is an
# availability/privacy choice, not a trust root). Point at a local caching PCCS
# to remove the third party and the ~700 ms per proof.
# FUGAL_PCCS_URL=https://pccs.phala.network

# Persisted scoring state and published artifacts. Keep them on durable disk;
# a validator that loses its frame scores the field differently from its peers.
FUGAL_STATE_PATH=/var/lib/fugal/validator_state.json
FUGAL_EPOCH_DIR=/var/lib/fugal/epochs
FUGAL_EPOCH_LOG_DIR=/var/lib/fugal
# Keep every verified miner head (raw bytes by sha256 + index.jsonl), private
# on this host (0700). Diagnostics only: no effect on scores. Unset = discard.
# FUGAL_HEAD_ARCHIVE_DIR=/var/lib/fugal/heads
# Public-read GCS bucket reveals are published to after the commit-reveal
# window (hash on chain). The reveal is the subnet's product: set it. Unset,
# the validator only warns and reveals never leave local disk.
FUGAL_REVEAL_BUCKET=<your-public-read-bucket>
# This host's public egress IPv4 (curl -s https://ifconfig.me). Recorded on
# chain at startup so miners can admit only validators at their firewall
# (scripts/axon_firewall.py). Nothing listens on it.
FUGAL_VALIDATOR_IP=<this-host-public-ipv4>

# A live validator also needs data/reference_frame.json in the checkout (the
# hash-pinned bootstrap frame) or FUGAL_FRAME_BOOTSTRAP pointing at a directory
# of published reveals; it refuses to start cold (INVARIANTS I1/I9).
# Protocol v2: every validator except the ROOT (the owner's) sets
# FUGAL_FRAME_BOOTSTRAP to a directory kept synced from the root's reveal
# bucket (gsutil -m rsync -r gs://<root-bucket>/<netuid> <dir>, on a timer);
# it re-syncs from it after a missed epoch or a lost proof. The root leaves
# it unset.
# FUGAL_FRAME_BOOTSTRAP=/var/lib/fugal/root-reveals
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
