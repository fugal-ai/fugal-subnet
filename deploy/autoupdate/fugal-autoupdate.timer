# Every 10 minutes: look for a newer signed validator-v* tag, stage it, and
# switch in the idle part of an epoch. A pass still running is not restarted;
# the tick is skipped. Disable: sudo systemctl disable --now fugal-autoupdate.timer
[Unit]
Description=Run fugal-autoupdate every 10 minutes

[Timer]
OnBootSec=15min
OnUnitActiveSec=10min
RandomizedDelaySec=1min
Persistent=true

[Install]
WantedBy=timers.target
