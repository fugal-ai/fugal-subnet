# /etc/fugal/watch.env — mode 0600. Read by deploy/systemd/fugal-watch.service.
# Nothing here is a key. The alert URL is the one value to keep private: whoever
# has it can post to your channel.
FUGAL_WATCH_NETWORK=test
FUGAL_WATCH_NETUID=552
# MUST equal FUGAL_EPOCH_INTERVAL in validator.env (tempo x 12 s).
FUGAL_WATCH_EPOCH_INTERVAL=4320
# This host's validator hotkey, and any others you want asserted each epoch.
FUGAL_WATCH_VALIDATORS=val1=<hotkey_ss58>
# Optional: miners to assert (routable axon, head commitment before the boundary).
FUGAL_WATCH_MINERS=
# Optional: reveal dirs to compare; two or more enables the agreement checks.
FUGAL_WATCH_REVEALS=val1=/var/lib/fugal/epochs
# Seconds one run may wait for the boundary; keep it above FUGAL_EPOCH_INTERVAL.
FUGAL_WATCH_TIMEOUT=5400
# Where a FAIL goes. ntfy: https://ntfy.sh/<topic>. discord: a channel webhook URL.
# An ntfy topic is readable by anyone who knows its name: make it long and random
# (e.g. fugal-<32 random chars>) and keep it out of the repo and chat.
# Empty: journal only (journalctl -t fugal-watch).
FUGAL_ALERT_URL=
FUGAL_ALERT_KIND=ntfy
# telegram: FUGAL_ALERT_KIND=telegram, FUGAL_ALERT_URL=https://api.telegram.org/bot<token>/sendMessage
# and the chat to post to. The bot token is a secret: this file is 0600 for that reason.
# deploy/systemd/fugal-alert-telegram-setup.sh fills all three without the token
# ever being typed into a chat or a shell history.
FUGAL_ALERT_CHAT_ID=
