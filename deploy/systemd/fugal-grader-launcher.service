[Unit]
Description=Fugal isolated OCI grading launcher
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=fugal-grader
Group=fugal-grader
SupplementaryGroups=docker fugal-validator
UMask=0117
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fugal/venv/bin/python -m fugal_subnet.sandbox.launcher --socket /run/fugal-grader/grader.sock --socket-group fugal-validator --allowed-uid fugal-validator --image REPLACE_WITH_SHA256_IMAGE_ID
RuntimeDirectory=fugal-grader
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
