[Unit]
Description=Fugal validator
After=network-online.target fugal-grader-launcher.service
Wants=network-online.target
Requires=fugal-grader-launcher.service

[Service]
Type=simple
User=fugal-validator
Group=fugal-validator
UMask=0077
EnvironmentFile=/etc/fugal/validator.env
ExecStart=/opt/fugal/venv/bin/fugal-validator-v2 --live --grader-socket /run/fugal-grader/grader.sock --wallet-path /var/lib/fugal-validator/wallets --state-root /var/lib/fugal-validator/v2
StateDirectory=fugal-validator
StateDirectoryMode=0700
ReadOnlyPaths=/run/fugal-grader/grader.sock
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
