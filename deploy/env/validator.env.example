# /etc/fugal/validator.env — mode 0600. Read by deploy/systemd/fugal-validator.service.
#
# Everything here is consensus-relevant or operational; nothing is secret. A
# validator holds no API key (it never calls a model) and no coldkey.

FUGAL_NETWORK=test
FUGAL_NETUID=552
WALLET_NAME=fugal_validator
HOTKEY_NAME=default

# MUST equal the subnet's tempo x 12 s. tempo 360 -> 4320. When they differ,
# some epochs' weights are overwritten before Yuma reads them (MAINNET_LAUNCH §2).
# `scripts/provision_subnet.py --status` prints ALIGNED or MISALIGNED.
FUGAL_EPOCH_INTERVAL=4320

# Comma-separated approved entries, each `<base_measurement>:<compose_hash>`.
# The base is `measurement_id()` of the dstack image on the cloud platform; the
# compose hash is sha256 of the miner's app-compose.json RAW BYTES
# (`scripts/compute_app_identity.py --compose ... --base ...`). A bare base
# would accept ANY application on that image.
FUGAL_TEE_MEASUREMENTS=

# Do NOT set FUGAL_BENCHMARK_POOL. The validator loads the manifest-pinned pool
# through load_all() and refuses to start if it does not match. A materialised
# pool file is only acceptable if it verifies against the same manifest.

# Where DCAP collateral is fetched from (Intel-signed; the endpoint is an
# availability/privacy choice, not a trust root). Point at a local caching PCCS
# to remove the third party and the ~700 ms per proof.
# FUGAL_PCCS_URL=https://pccs.phala.network

# Persisted scoring state and published artifacts. Keep them on durable disk;
# a validator that loses its frame scores the field differently from its peers.
FUGAL_STATE_PATH=/var/lib/fugal/validator_state.json
FUGAL_EPOCH_DIR=/var/lib/fugal/epochs
FUGAL_EPOCH_LOG_DIR=/var/lib/fugal
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
